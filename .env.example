# Local-only runtime. Copy to .env.local and replace every placeholder.
VAANI_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-worker-secret

# Optional. Without these values the billing UI runs an explicitly labelled
# local sandbox checkout that never charges real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer sales collections. Use Razorpay Test Mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API. The payment template must be approved in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PAYMENT_TEMPLATE=vaani_payment_link
WHATSAPP_TEMPLATE_LANGUAGE=en

# Email fallback for payment links when WhatsApp is unavailable.
RESEND_API_KEY=
EMAIL_FROM=payments@example.com

# Optional private AI routing. Customer-facing UI keeps Vaani engine names.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Live telephony. Mumbai is the default Exotel cluster.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_CLUSTER=mumbai
VOICE_STREAM_URL=wss://voice-gateway.example.com/media
TELEPHONY_WEBHOOK_SECRET=

# Google sign-in remains admin-disabled until these are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
