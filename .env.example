# Local-only runtime. Copy to .env.local and replace every placeholder.
VAANI_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Without these values the billing UI runs an explicitly labelled
# local sandbox checkout that never charges real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer sales collections. Use Razorpay Test Mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API. The payment template must be approved in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PAYMENT_TEMPLATE=vaani_payment_link
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional private AI routing. Customer-facing UI keeps Vaani engine names.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
