# Local-only runtime. Copy to .env.local and replace every placeholder.
VAANI_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-worker-secret

# Optional. Without these values the billing UI runs an explicitly labelled
# local sandbox checkout that never charges real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer sales collections. Use Razorpay Test Mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API. The payment template must be approved in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PAYMENT_TEMPLATE=vaani_payment_link
WHATSAPP_TEMPLATE_LANGUAGE=en

# Email fallback for payment links when WhatsApp is unavailable.
RESEND_API_KEY=
EMAIL_FROM=payments@example.com

# Optional private AI routing. Customer-facing UI keeps Vaani engine names.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Live telephony. Mumbai is the default Exotel cluster.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_CLUSTER=mumbai
# Optional second carrier. Use this for failover or global numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=
VOICE_STREAM_URL=wss://voice-gateway.example.com/media
TELEPHONY_WEBHOOK_SECRET=

# Private recording/export vault. Keep the bucket private and use signed URLs.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_SSE_KMS_KEY_ID=
# S3-compatible deployments may use these names instead of R2_*.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Transactional email (used for WhatsApp fallback and account notifications).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=notifications@example.com

# Enterprise identity (disabled until an IdP is registered and metadata is verified).
SSO_ENABLED=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
SCIM_ENABLED=false
SCIM_BASE_URL=http://localhost:3000/api/scim/v2
SCIM_TOKEN=

# Google sign-in remains admin-disabled until these are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
